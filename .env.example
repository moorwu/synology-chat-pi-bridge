# HTTP listener for Synology outgoing webhooks.
SYNOLOGY_CHAT_LISTEN_HOST=0.0.0.0
SYNOLOGY_CHAT_PORT=8789

# Outgoing webhook token(s) generated by Synology Chat.
# Use either one token or a comma-separated token set.
SYNOLOGY_CHAT_OUTGOING_TOKEN=replace-with-outgoing-token
SYNOLOGY_CHAT_OUTGOING_TOKENS=

# Default incoming webhook URL used for replies.
SYNOLOGY_CHAT_INCOMING_URL=http://nas:5000/webapi/entry.cgi?api=SYNO.Chat.External&method=incoming&version=2&token=%22replace%22

# Optional per-channel reply map. Keys can be channel names or channel IDs.
SYNOLOGY_CHAT_INCOMING_URLS_JSON={"general":"http://nas:5000/webapi/entry.cgi?api=SYNO.Chat.External&method=incoming&version=2&token=%22replace%22"}

# Names that should be ignored to avoid bot self-trigger loops.
SYNOLOGY_CHAT_IGNORE_USERS=Pi Bot

# Public base URL that Synology Chat can fetch for returned files.
# Set this to the bridge host's LAN address, not localhost.
SYNOLOGY_CHAT_FILE_BASE_URL=http://192.168.1.10:8789

# Pi / agent settings.
PI_PATH=pi
PI_WORKSPACE_DIR=~/agent-workspace
PI_DEFAULT_PROVIDER=
PI_DEFAULT_MODEL=
PI_THINKING_LEVEL=medium
PI_SYNOLOGY_DATA_DIR=~/.local/share/synology-chat-pi-bridge

# Optional model switch targets for the /model command.
PI_MODEL_TARGETS_JSON={"local":{"provider":"example-provider","model":"example-model","label":"Local model"}}
PI_MODEL_ALIASES_JSON={"local":"local"}
